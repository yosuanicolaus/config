            "complex_modifications": {
                "rules": [
                    { "eval_js": "// JavaScript must be written in ECMAScript 5.1.\n//\nvar halfPageRepeatCount = 15;\n\n// Helper function to replace spread operator {...template, ...overrides}\nfunction mergeTemplate(fromKey, toActions) {\n  var result = {\n    type: 'basic',\n    conditions: [\n      {\n        type: 'frontmost_application_if',\n        bundle_identifiers: ['md.obsidian']\n      },\n      {\n        type: \"expression_unless\",\n        description: \"Disable this rule when the focused element is a text area\",\n        expression: \"accessibility.focused_ui_element.role_string == 'AXTextArea'\"\n      }\n    ],\n    from: fromKey,\n    to: toActions\n  };\n  return result;\n}\n\nfunction main() {\n  var mappings = [\n    { from: '1', to: 'h' },\n    { from: '3', to: 'k' },\n    { from: '5', to: 'l' }\n  ];\n\n  var manipulators = [];\n\n  for (var i = 0; i < mappings.length; ++i) {\n    var mapping = mappings[i];\n    manipulators.push(mergeTemplate(\n      { key_code: mapping.from },\n      [{ key_code: mapping.to }]\n    ));\n  }\n\n  return {\n    description: 'Obsidian Excalidraw',\n    manipulators: manipulators\n  };\n}\n\nmain()\n\n" },
                    { "eval_js": "// JavaScript must be written in ECMAScript 5.1.\n\nfunction getOpenScript(app) {\n  if (app === 'IDE') {\n    // If CLion is open, open it. Else if PyCharm is open, open it.\n    return \"pgrep -x clion > /dev/null && open -a clion || (pgrep -x pycharm > /dev/null && open -a pycharm)\";\n  }\n  return \"open -a '\" + app + \"'\";\n}\n\nfunction main() {\n  var apps = [\n    { keys: ['a', '1'], name: 'Discord' },\n    { keys: ['s', '2'], name: 'IDE' },\n    { keys: ['d', '3'], name: 'kitty' },\n    { keys: ['f', '4'], name: 'Google Chrome' },\n    { keys: ['z', '5'], name: 'Finder' },\n    { keys: ['x', '6'], name: 'wxmaxima' },\n    { keys: ['c', '7'], name: 'clock' },\n    { keys: ['v', '8'], name: 'sioyek' }\n  ];\n\n  var modifiersSets = [\n    ['left_command', 'right_command'],\n    ['left_control', 'left_gui']\n  ];\n\n  var manipulators = [];\n\n  for (var i = 0; i < apps.length; i++) {\n    var appEntry = apps[i];\n    var shellCommand = getOpenScript(appEntry.name);\n\n    for (var j = 0; j < appEntry.keys.length; j++) {\n      var keyCode = appEntry.keys[j];\n\n      for (var k = 0; k < modifiersSets.length; k++) {\n        var modifiers = modifiersSets[k];\n\n        manipulators.push({\n          type: 'basic',\n          from: {\n            key_code: keyCode,\n            modifiers: {\n              mandatory: modifiers\n            }\n          },\n          to: [\n            {\n              shell_command: shellCommand\n            }\n          ]\n        });\n      }\n    }\n  }\n\n  return {\n    description: \"YOSUA'S APPS\",\n    manipulators: manipulators\n  };\n}\n\nmain();\n" },
                    { "eval_js": "// JavaScript must be written in ECMAScript 5.1.\n//\nvar halfPageRepeatCount = 15;\n\n// Helper function to replace spread operator {...template, ...overrides}\nfunction mergeTemplate(fromKey, toActions) {\n  var result = {\n    type: 'basic',\n    conditions: [\n      {\n        type: 'frontmost_application_if',\n        bundle_identifiers: ['com.github.xournalpp']\n      }\n    ],\n    from: fromKey,\n    to: toActions\n  };\n  return result;\n}\n\nfunction main() {\n  var mappings = [\n    { from: 'a', to: 'a' }, { from: 'g', to: 'g' },\n    { from: 'x', to: 'd' }, { from: 'w', to: 'p' },\n    { from: 'q', to: 'g' }, { from: 'e', to: 'e' },\n    { from: 'r', to: 'r' }, { from: 'v', to: 'v' },\n    { from: 'z', to: 'h' }, { from: 'c', to: 'o' }\n  ];\n\n  var manipulators = [];\n\n  for (var i = 0; i < mappings.length; ++i) {\n    var mapping = mappings[i];\n    manipulators.push(mergeTemplate(\n      { key_code: mapping.from },\n      [{ key_code: mapping.to, modifiers: ['left_command', 'left_shift'] }]\n    ));\n  }\n\n  function createRepeatAction(fromKey, targetKey) {\n    var toActions = [];\n    for (var j = 0; j < halfPageRepeatCount; j++) {\n      toActions.push({ key_code: targetKey });\n    }\n    return mergeTemplate({ key_code: fromKey }, toActions);\n  }\n\n  manipulators.push(createRepeatAction('d', 'down_arrow'));\n  manipulators.push(createRepeatAction('f', 'up_arrow'));\n  manipulators.push(createRepeatAction('u', 'up_arrow'));\n\n  manipulators.push(mergeTemplate(\n    { key_code: 'j', modifiers: { mandatory: ['left_shift'] } },\n    [{ key_code: 'page_down' }]\n  ));\n  manipulators.push(mergeTemplate(\n    { key_code: 'k', modifiers: { mandatory: ['left_shift'] } },\n    [{ key_code: 'page_up' }]\n  ));\n\n  return {\n    description: 'Xournal++',\n    manipulators: manipulators\n  };\n}\n\nmain()\n" },
